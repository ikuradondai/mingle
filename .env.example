# Optional Supabase account features. Guest play works without these values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Keep server-only; required only for account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Set true only after Google OAuth credentials and callback allowlists are configured.
SUPABASE_GOOGLE_ENABLED=false
