# Optional Supabase account features. Guest play works without these values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Server-only; required for account deletion and LINE daily service RPCs.
SUPABASE_SERVICE_ROLE_KEY=
# Set true only after Google OAuth credentials and callback allowlists are configured.
SUPABASE_GOOGLE_ENABLED=false

# LINE Messaging API server-only settings. Never expose these values to browser code.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional HTTPS API base override for isolated tests; defaults to https://api.line.me.
LINE_API_BASE_URL=https://api.line.me
# Official friend URL shown by readiness UI; must be https://lin.ee/... or https://line.me/...
LINE_OFFICIAL_FRIEND_URL=
# Public HTTPS origin used for account-link and daily links.
MINGLE_PUBLIC_ORIGIN=https://mingle.cards
# Keep false until migrations, webhook, scheduler, and operator checks are complete.
LINE_DELIVERY_ENABLED=false
# External scheduler secret, sent as x-mingle-cron-secret. Do not use CRON_SECRET.
MINGLE_DAILY_CRON_SECRET=
# Vercel Node runtime: preserve the raw IncomingMessage stream for webhook HMAC verification.
NODEJS_HELPERS=0
