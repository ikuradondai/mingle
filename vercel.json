{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "host", "value": "about.mingle.cards" }],
      "dest": "/about/index.html"
    },
    { "src": "/admin/?", "dest": "/admin.html" },
    { "handle": "filesystem" }
  ]
}
